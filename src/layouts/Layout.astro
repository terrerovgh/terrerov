---
import '../styles/global.css';

export interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
}

const {
	title = "Terrerov — Custom Web Design for Local Businesses | Louisville, KY",
	description = "Independent web design studio in Louisville, Kentucky. Custom sites, local SEO, and online booking for tattoo studios, restaurants, barbershops, and local businesses. English & Español.",
	ogImage = "/og-image.png"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const ogImageURL = new URL(ogImage, Astro.site ?? Astro.url.origin);

const structuredData = {
	"@context": "https://schema.org",
	"@type": "ProfessionalService",
	"@id": "https://www.terrerov.com/#studio",
	name: "Terrerov Studio",
	description:
		"Independent web design studio for local businesses — custom web design, local SEO, and online booking integration.",
	url: "https://www.terrerov.com/",
	email: "hola@terrerov.com",
	image: ogImageURL.href,
	address: {
		"@type": "PostalAddress",
		addressLocality: "Louisville",
		addressRegion: "KY",
		addressCountry: "US"
	},
	areaServed: {
		"@type": "City",
		name: "Louisville",
		containedInPlace: { "@type": "State", name: "Kentucky" }
	},
	knowsLanguage: ["en", "es"],
	sameAs: [
		"https://instagram.com/terrerov",
		"https://linkedin.com/company/terrerov"
	],
	makesOffer: [
		"Custom web design & development",
		"Websites for tattoo studios & artists",
		"Local SEO",
		"Online booking integration",
		"Website care & monthly updates",
		"Website redesign"
	].map((service) => ({
		"@type": "Offer",
		itemOffered: { "@type": "Service", name: service }
	}))
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<meta name="robots" content="index, follow" />
		<meta name="theme-color" content="#FBFBF9" />
		<meta name="author" content="Terrerov Studio" />
		<meta name="geo.region" content="US-KY" />
		<meta name="geo.placename" content="Louisville" />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Terrerov Studio" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Terrerov — Web design that elevates local business" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:locale:alternate" content="es_US" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<link rel="sitemap" href="/sitemap-index.xml" />

		<link rel="preload" href="/assets/temple-roof-cutout-web.webp" as="image" type="image/webp" fetchpriority="high" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />

		<script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />

		<script is:inline>
			// Apply the saved (or system) theme before first paint to avoid a flash
			(function () {
				var stored = localStorage.getItem('theme');
				var dark = stored
					? stored === 'dark'
					: window.matchMedia('(prefers-color-scheme: dark)').matches;
				document.documentElement.classList.toggle('dark', dark);
				if (dark) {
					var meta = document.querySelector('meta[name="theme-color"]');
					if (meta) meta.setAttribute('content', '#141312');
				}
			})();
		</script>
	</head>
	<body class="bg-(--bg) text-(--ink) font-sans antialiased">
		<slot />
	</body>
</html>
