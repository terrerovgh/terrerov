---
// Design concept: bold one-page site for a tattoo studio in Albuquerque, NM
const title = 'Cuba Tattoo Studio — Albuquerque, NM · Design Concept by Terrerov';
const description =
  'Design concept: a bold, minimalist one-page website for Cuba Tattoo Studio in Albuquerque, New Mexico — artists, styles, and booking.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="backlink" href="/#works">← TERREROV · DESIGN CONCEPT</a>

    <header class="top">
      <span class="brand">CUBA<span class="star">★</span>TATTOO</span>
      <nav>
        <a href="#artists">ARTISTS</a>
        <a href="#styles">STYLES</a>
        <a href="#visit">VISIT</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <h1>INK WITH<br /><span class="outline">HERITAGE.</span></h1>
        <p class="sub">Custom tattoos in the heart of Albuquerque. Walk in with an idea — walk out with a story on your skin.</p>
        <div class="hero-meta">
          <span>EST. 2014</span>
          <span>ALBUQUERQUE, NM</span>
          <span>WALK-INS WELCOME</span>
        </div>
        <a class="btn" href="#visit">BOOK A SESSION</a>
      </section>

      <div class="marquee" aria-hidden="true">
        <div class="track">
          BLACKWORK ★ TRADITIONAL ★ FINE LINE ★ CHICANO LETTERING ★ REALISM ★ BLACKWORK ★ TRADITIONAL ★ FINE LINE ★ CHICANO LETTERING ★ REALISM ★
        </div>
      </div>

      <section id="artists" class="artists">
        <h2>THE ARTISTS</h2>
        <div class="grid">
          <article><span class="ph">RM</span><h3>Rosa M.</h3><p>Fine line · botanical</p></article>
          <article><span class="ph">DV</span><h3>Diego V.</h3><p>Chicano lettering · script</p></article>
          <article><span class="ph">KT</span><h3>Kai T.</h3><p>American traditional</p></article>
          <article><span class="ph">SN</span><h3>Sam N.</h3><p>Blackwork · geometric</p></article>
        </div>
      </section>

      <section id="styles" class="styles">
        <h2>WHAT WE DO</h2>
        <ul>
          <li><span>01</span>Custom design — every piece drawn for you, never flash-only.</li>
          <li><span>02</span>Cover-ups and reworks that respect what came before.</li>
          <li><span>03</span>Consultations in English y en español, always free.</li>
          <li><span>04</span>Hospital-grade sterilization. No exceptions, no shortcuts.</li>
        </ul>
      </section>

      <section id="visit" class="visit">
        <div>
          <h2>VISIT THE SHOP</h2>
          <p class="addr">
            412 Central Ave SW<br />
            Albuquerque, NM 87102
          </p>
          <p class="hours">TUE–SAT · 12PM – 9PM</p>
        </div>
        <div class="book">
          <p>Deposits secure your slot. Bring references, questions, and your pain face.</p>
          <a class="btn light" href="mailto:hola@terrerov.com?subject=Cuba%20Tattoo%20Studio%20Booking">REQUEST BOOKING</a>
        </div>
      </section>
    </main>

    <footer>
      <span>CUBA TATTOO STUDIO — ALBUQUERQUE</span>
      <span>DESIGN CONCEPT BY <a href="/">TERREROV</a></span>
    </footer>
  </body>
</html>

<style>
  :root {
    --bg: #0a0a0a;
    --ink: #f5f2ec;
    --dim: #8f8b83;
    --line: #262421;
    --red: #e64a3b; /* text accents on dark bg (WCAG AA) */
    --red-deep: #c8392b; /* fills behind light text */
  }
  * { margin: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--bg);
    color: var(--ink);
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 15px;
    line-height: 1.65;
  }
  a { color: inherit; text-decoration: none; }

  .backlink {
    position: fixed; bottom: 18px; left: 18px; z-index: 30;
    font-size: 11px; letter-spacing: 0.14em; color: var(--dim);
    background: var(--bg); border: 1px solid var(--line);
    padding: 8px 14px;
    transition: color .2s, border-color .2s;
  }
  .backlink:hover { color: var(--ink); border-color: var(--red); }

  .top {
    position: sticky; top: 0; z-index: 20;
    display: flex; justify-content: space-between; align-items: center;
    padding: 20px clamp(20px, 5vw, 64px);
    background: rgba(10, 10, 10, 0.86); backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .brand { font-family: 'Archivo Black', sans-serif; font-size: 15px; letter-spacing: 0.12em; }
  .star { color: var(--red); padding: 0 6px; }
  .top nav { display: flex; gap: clamp(18px, 3vw, 40px); }
  .top nav a { font-size: 10.5px; letter-spacing: 0.22em; font-weight: 600; color: var(--dim); transition: color .2s; }
  .top nav a:hover { color: var(--red); }

  main > section { padding: clamp(64px, 10vh, 120px) clamp(20px, 5vw, 64px); max-width: 1100px; margin: 0 auto; }

  .hero { min-height: 80svh; display: flex; flex-direction: column; justify-content: center; }
  h1 {
    font-family: 'Archivo Black', sans-serif;
    font-size: clamp(52px, 10.5vw, 140px);
    line-height: 0.98; letter-spacing: 0.005em;
  }
  .outline {
    color: transparent;
    -webkit-text-stroke: 2px var(--ink);
  }
  .sub { margin-top: 30px; max-width: 46ch; color: var(--dim); font-size: 16px; }
  .hero-meta { display: flex; gap: clamp(18px, 4vw, 44px); margin-top: 34px; flex-wrap: wrap; font-size: 10.5px; letter-spacing: 0.24em; color: var(--dim); }
  .btn {
    display: inline-block; width: fit-content; margin-top: 44px;
    background: var(--red-deep); color: var(--ink);
    font-size: 12px; font-weight: 600; letter-spacing: 0.2em;
    padding: 16px 34px;
    transition: transform .15s, background .2s;
  }
  .btn:hover { background: #a92e22; transform: translateY(-2px); }
  .btn.light { background: var(--ink); color: var(--bg); }
  .btn.light:hover { background: #d8d4cc; }

  .marquee { overflow: hidden; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 14px 0; }
  .track {
    white-space: nowrap; font-family: 'Archivo Black', sans-serif;
    font-size: 13px; letter-spacing: 0.3em; color: var(--dim);
    animation: slide 28s linear infinite;
    width: max-content;
  }
  @keyframes slide { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .track { animation: none; } }

  h2 { font-family: 'Archivo Black', sans-serif; font-size: clamp(24px, 3.6vw, 40px); letter-spacing: 0.03em; margin-bottom: 48px; }

  .artists .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr)); gap: 28px; }
  .artists article { border: 1px solid var(--line); padding: 28px 24px; transition: border-color .2s; }
  .artists article:hover { border-color: var(--red); }
  .ph {
    display: flex; align-items: center; justify-content: center;
    aspect-ratio: 1; margin-bottom: 20px;
    background: repeating-linear-gradient(45deg, #141311 0 10px, #0f0e0c 10px 20px);
    font-family: 'Archivo Black', sans-serif; font-size: 34px; color: var(--dim);
  }
  .artists h3 { font-size: 17px; font-weight: 600; }
  .artists p { color: var(--dim); font-size: 13px; margin-top: 4px; }

  .styles ul { list-style: none; padding: 0; max-width: 720px; }
  .styles li {
    display: flex; gap: 26px; align-items: baseline;
    padding: 22px 0; border-top: 1px solid var(--line);
    font-size: clamp(16px, 2vw, 20px);
  }
  .styles li:last-child { border-bottom: 1px solid var(--line); }
  .styles span { color: var(--red); font-size: 12px; letter-spacing: 0.2em; font-weight: 600; }

  .visit { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: clamp(36px, 6vw, 80px); align-items: start; }
  .addr { font-size: clamp(18px, 2.4vw, 24px); line-height: 1.5; }
  .hours { margin-top: 18px; font-size: 11px; letter-spacing: 0.24em; color: var(--red); font-weight: 600; }
  .book p { color: var(--dim); max-width: 40ch; }

  footer {
    display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;
    padding: 28px clamp(20px, 5vw, 64px);
    border-top: 1px solid var(--line);
    font-size: 10.5px; letter-spacing: 0.18em; color: var(--dim);
  }
  footer a { color: var(--ink); border-bottom: 1px solid var(--red); }
</style>
