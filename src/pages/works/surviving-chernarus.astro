---
// Design concept: autonomous digital-resilience system, post-apocalyptic tone
import ChernarusMark from '../../components/ChernarusMark.astro';
const title = 'Surviving Chernarus — Autonomous Resilience System · Design Concept by Terrerov';
const description =
  'Design concept: a one-page site for Surviving Chernarus, an autonomous digital resilience system for real-world tasks, with a post-apocalyptic mission-control aesthetic.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0C0E0B" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="backlink" href="/#works">← TERREROV · DESIGN CONCEPT</a>

    <header class="top">
      <span class="brand"><ChernarusMark size={26} withWordmark={false} class="brand-mark" />SURVIVING CHERNARUS</span>
      <span class="status"><span class="dot"></span>SYSTEM ONLINE</span>
    </header>

    <main>
      <section class="hero">
        <ChernarusMark size={124} withWordmark={false} class="hero-mark" />
        <p class="kicker">AUTONOMOUS DIGITAL RESILIENCE — v2.4.1</p>
        <h1>Autonomy for<br />the end of the world.</h1>
        <p class="lede">
          An autonomous system that plans, executes, and verifies real-world tasks
          when infrastructure can't be trusted. Offline-first. Self-healing.
          Unreasonably calm under pressure.
        </p>
        <div class="cta-row">
          <a class="btn" href="#modules">EXPLORE MODULES ▸</a>
          <span class="coords">49.4406°N · 36.8567°E</span>
        </div>
      </section>

      <section class="strip" aria-label="System status">
        <div><span class="num">99.97%</span><span class="lbl">UPTIME / 365D</span></div>
        <div><span class="num">1,204</span><span class="lbl">TASKS EXECUTED</span></div>
        <div><span class="num">31</span><span class="lbl">MESH NODES</span></div>
        <div><span class="num">0</span><span class="lbl">HUMANS PANICKING</span></div>
      </section>

      <section id="modules" class="modules">
        <h2>// MODULES</h2>
        <div class="grid">
          <article>
            <span class="idx">01</span>
            <h3>TASK ENGINE</h3>
            <p>Plans and dispatches real-world routines — supply runs, maintenance, checks — and verifies completion without supervision.</p>
          </article>
          <article>
            <span class="idx">02</span>
            <h3>COMMS RELAY</h3>
            <p>Offline-first mesh messaging. If one node goes dark, the message finds another way. It always finds another way.</p>
          </article>
          <article>
            <span class="idx">03</span>
            <h3>SUPPLY LEDGER</h3>
            <p>Inventory of everything that matters: fuel, parts, food, morale. Forecasts shortages before they become stories.</p>
          </article>
          <article>
            <span class="idx">04</span>
            <h3>WATCHTOWER</h3>
            <p>Perimeter monitoring for your digital estate. Anomalies are flagged, triaged, and neutralized while you sleep.</p>
          </article>
        </div>
      </section>

      <section class="log" aria-label="Activity log">
        <h2>// LAST TRANSMISSIONS</h2>
        <pre>
[04:12:07] task#1187 WATER-FILTER-CHECK ..... OK
[04:47:33] node NW-07 rejoined mesh (2 hops)
[05:02:10] ledger: fuel reserve 82% → reorder scheduled
[05:30:00] all systems nominal. carry on.</pre>
      </section>

      <section class="access">
        <h2>Request access</h2>
        <p>The system accepts new operators quarterly. Bring patience and a flashlight.</p>
        <a class="btn" href="mailto:hola@terrerov.com?subject=Surviving%20Chernarus">REQUEST ACCESS ▸</a>
      </section>
    </main>

    <footer>
      <span>SURVIVING CHERNARUS — STAY LOW, KEEP MOVING</span>
      <span>DESIGN CONCEPT BY <a href="/">TERREROV</a></span>
    </footer>
  </body>
</html>

<style>
  :root {
    --bg: #0c0e0b;
    --panel: #12150f;
    --ink: #c9d1bb;
    --dim: #7d8570;
    --line: #242920;
    --acc: #d9662a;
    --grn: #8fbf6b;
  }
  * { margin: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--bg);
    color: var(--ink);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 15px;
    line-height: 1.6;
    background-image: repeating-linear-gradient(0deg, transparent 0 2px, rgba(0,0,0,0.18) 2px 4px);
  }
  a { color: inherit; text-decoration: none; }

  .backlink {
    position: fixed; bottom: 18px; left: 18px; z-index: 30;
    font-size: 11px; letter-spacing: 0.14em;
    background: var(--panel); border: 1px solid var(--line);
    padding: 8px 14px; color: var(--dim);
    transition: color .2s, border-color .2s;
  }
  .backlink:hover { color: var(--ink); border-color: var(--dim); }

  .top {
    display: flex; justify-content: space-between; align-items: center;
    padding: 20px clamp(20px, 5vw, 56px);
    border-bottom: 1px solid var(--line);
    font-size: 12px; letter-spacing: 0.22em;
  }
  .brand { display: flex; align-items: center; gap: 12px; }
  .brand-mark { flex-shrink: 0; }
  .status { display: flex; align-items: center; gap: 8px; color: var(--grn); font-size: 11px; }
  .dot {
    width: 7px; height: 7px; border-radius: 50%; background: var(--grn);
    box-shadow: 0 0 8px var(--grn);
    animation: pulse 2.2s infinite;
  }
  @keyframes pulse { 50% { opacity: 0.35; } }

  main > section { padding: clamp(56px, 9vh, 110px) clamp(20px, 5vw, 56px); max-width: 1080px; margin: 0 auto; }

  .hero { min-height: 78svh; display: flex; flex-direction: column; justify-content: center; }
  .hero-mark { margin-bottom: 32px; }
  .kicker { font-size: 11px; letter-spacing: 0.3em; color: var(--acc); margin-bottom: 28px; }
  h1 {
    font-size: clamp(34px, 6.4vw, 74px); font-weight: 600;
    line-height: 1.08; letter-spacing: -0.01em; text-transform: uppercase;
  }
  .lede { margin-top: 28px; max-width: 54ch; color: var(--dim); }
  .cta-row { display: flex; align-items: center; gap: 28px; margin-top: 44px; flex-wrap: wrap; }
  .btn {
    display: inline-block; padding: 14px 26px;
    border: 1px solid var(--acc); color: var(--acc);
    font-size: 12px; letter-spacing: 0.18em;
    transition: background .2s, color .2s;
  }
  .btn:hover { background: var(--acc); color: var(--bg); }
  .coords { font-size: 11px; letter-spacing: 0.2em; color: var(--dim); }

  .strip {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1px; background: var(--line);
    border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
    padding: 0 !important; max-width: none !important;
  }
  .strip div { background: var(--panel); padding: 26px clamp(16px, 3vw, 36px); display: flex; flex-direction: column; gap: 6px; }
  .num { font-size: clamp(22px, 3vw, 32px); font-weight: 600; color: var(--ink); }
  .lbl { font-size: 10px; letter-spacing: 0.22em; color: var(--dim); }

  h2 { font-size: 13px; letter-spacing: 0.3em; color: var(--acc); font-weight: 500; margin-bottom: 40px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .grid article { background: var(--bg); padding: 30px 26px; }
  .idx { font-size: 11px; color: var(--acc); letter-spacing: 0.2em; }
  h3 { margin: 14px 0 10px; font-size: 15px; letter-spacing: 0.16em; font-weight: 600; }
  .grid p { font-size: 13.5px; color: var(--dim); }

  .log pre {
    background: var(--panel); border: 1px solid var(--line);
    padding: 26px; font-size: 12.5px; line-height: 1.9;
    color: var(--grn); overflow-x: auto; font-family: inherit;
  }

  .access { text-align: left; }
  .access h2 { color: var(--ink); font-size: clamp(24px, 3.4vw, 36px); letter-spacing: -0.01em; text-transform: uppercase; margin-bottom: 14px; }
  .access p { color: var(--dim); margin-bottom: 32px; }

  footer {
    display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;
    padding: 28px clamp(20px, 5vw, 56px);
    border-top: 1px solid var(--line);
    font-size: 10.5px; letter-spacing: 0.18em; color: var(--dim);
  }
  footer a { color: var(--ink); border-bottom: 1px solid var(--dim); }
</style>
