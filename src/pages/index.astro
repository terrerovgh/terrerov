---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, services, process, facts } from '../data/site';

const mailHref = `mailto:${site.email}?subject=${encodeURIComponent('Project inquiry — Terrerov')}`;
---

<BaseLayout>
  <main class="stage" id="main" aria-label="Terrerov studio">
    <header class="topbar">
      <span class="brand">{site.name}</span>
      <div class="topbar__meta">
        <span class="pill loc">{site.locationLine}</span>
        <a class="mail-link" href={mailHref}>{site.email}</a>
        <button
          class="configure"
          id="configure"
          type="button"
          aria-expanded="false"
          aria-controls="settings"
        >
          Play
        </button>
      </div>
    </header>

    <div class="stage__art">
      <div class="artboard" id="artboard">
        <canvas
          id="curtain"
          role="img"
          aria-label="Interactive curtain that forms a scannable QR code to terrerov.com"
        ></canvas>

        <div class="temple" id="temple">
          <picture>
            <source id="temple-webp" srcset="/assets/temple-roof-cutout-web.webp" type="image/webp" />
            <img
              id="temple-img"
              src="/assets/temple-roof-cutout-web.png"
              width="901"
              height="730"
              fetchpriority="high"
              decoding="async"
              alt="Temple of Heaven roof illustration"
            />
          </picture>
        </div>

        <div class="cursor" id="cursor" aria-hidden="true"></div>

        <aside class="settings" id="settings" hidden>
          <p class="settings-title">Curtain</p>
          <div class="setting">
            <label for="roof">Roof study</label>
            <select id="roof"></select>
          </div>
          <div class="setting">
            <label for="mode">Mode</label>
            <select id="mode">
              <option value="qr" selected>QR · terrerov.com</option>
              <option value="classic">Classic characters</option>
            </select>
          </div>
          <div class="setting">
            <label for="strength">Strength <output id="strengthValue">72</output></label>
            <input id="strength" type="range" min="20" max="110" value="72" />
          </div>
          <div class="setting">
            <label for="reach">Reach <output id="reachValue">34</output></label>
            <input id="reach" type="range" min="18" max="56" value="34" />
          </div>
          <div class="setting">
            <label for="inertia">Inertia <output id="inertiaValue">97</output></label>
            <input id="inertia" type="range" min="86" max="99" value="97" />
          </div>
          <button class="reset" id="reset" type="button">Reset</button>
        </aside>
      </div>

      <div class="scan-hint" aria-hidden="true">
        <div class="progress"></div>
        <p>Drag · scan when still</p>
      </div>
    </div>

    <section class="sheet" aria-label="Studio information">
      <div class="sheet__intro">
        <h1>{site.tagline}</h1>
        <p class="lede">{site.lede}</p>
        <ul class="facts">
          {facts.map((f) => <li>{f}</li>)}
          <li>{site.timeline}</li>
        </ul>
      </div>

      <ul class="services" aria-label="Services">
        {
          services.map((s, i) => (
            <li>
              <span>{String(i + 1).padStart(2, '0')}</span>
              {s}
            </li>
          ))
        }
      </ul>

      <div class="sheet__foot">
        <div class="process" aria-label="Process">
          {process.map((step) => <span>{step}</span>)}
        </div>
        <div class="actions">
          <a class="btn" href={mailHref}>Start a project</a>
          <a
            class="btn btn-ghost"
            href={site.githubLab}
            target="_blank"
            rel="noopener noreferrer"
          >
            Lab · Chernarus
          </a>
        </div>
      </div>
    </section>
  </main>

  <script>
    import { initCurtain } from '../scripts/curtain';
    initCurtain();
  </script>
</BaseLayout>
