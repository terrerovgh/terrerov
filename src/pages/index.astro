---
const title = 'Terrerov — Louisville web design';
const description =
  'Independent web studio. Interactive Temple of Heaven curtain — a scannable QR to terrerov.com.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://www.terrerov.com/" />
    <meta name="theme-color" content="#e8dfca" />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/assets/temple-roof-cutout-web.webp" as="image" type="image/webp" fetchpriority="high" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Terrerov" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://www.terrerov.com/" />
    <meta property="og:locale" content="en_US" />

    <style is:global>
      :root {
        --paper: #e8dfca;
        --ink: #2e251f;
        --muted: #70665b;
        --hairline: rgba(46, 37, 31, 0.36);
        --panel: rgba(232, 223, 202, 0.93);
      }

      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        min-height: 100%;
      }
      body {
        background: var(--paper);
        color: var(--ink);
        font-family: Arial, Helvetica, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      button,
      input,
      select {
        font: inherit;
      }

      .artboard {
        position: relative;
        min-height: 100svh;
        overflow: hidden;
        isolation: isolate;
        background:
          repeating-linear-gradient(91deg, rgba(46, 37, 31, 0.022) 0 1px, transparent 1px 11px),
          repeating-linear-gradient(2deg, rgba(46, 37, 31, 0.017) 0 1px, transparent 1px 14px),
          radial-gradient(circle at 53% 16%, rgba(255, 255, 255, 0.26), transparent 34%),
          var(--paper);
      }

      .artboard::after {
        content: '';
        position: absolute;
        inset: 0;
        z-index: 10;
        pointer-events: none;
        opacity: 0.14;
        background-image:
          radial-gradient(circle at 24% 31%, currentColor 0 0.5px, transparent 0.65px),
          radial-gradient(circle at 71% 56%, currentColor 0 0.45px, transparent 0.6px);
        background-size:
          9px 11px,
          13px 15px;
        mix-blend-mode: multiply;
      }

      #curtain {
        position: absolute;
        inset: 0;
        z-index: 2;
        width: 100%;
        height: 100%;
        cursor: none;
        touch-action: none;
      }

      .masthead {
        position: absolute;
        z-index: 8;
        top: 28px;
        left: clamp(24px, 5vw, 94px);
        right: clamp(24px, 5vw, 94px);
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 28px;
        font: 12px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
        color: var(--muted);
      }

      .brand {
        color: var(--ink);
        font-family: Georgia, 'Times New Roman', serif;
        font-size: 15px;
        text-decoration: none;
      }
      .brand:hover {
        color: var(--ink);
      }

      .nav {
        display: flex;
        gap: 28px;
      }
      .nav a {
        color: inherit;
        text-decoration: none;
      }
      .nav a:hover {
        color: var(--ink);
      }

      .masthead-actions {
        justify-self: end;
        display: flex;
        align-items: center;
        gap: 18px;
      }

      .mail-link {
        padding: 7px 0 6px;
        border-bottom: 1px solid transparent;
        color: inherit;
        text-decoration: none;
      }
      .mail-link:hover {
        color: var(--ink);
        border-bottom-color: currentColor;
      }

      .configure {
        border: 0;
        padding: 7px 13px 6px;
        color: var(--paper);
        background: var(--ink);
        font-family: Georgia, 'Times New Roman', serif;
        cursor: pointer;
        clip-path: polygon(4% 6%, 96% 0, 100% 91%, 2% 100%);
      }

      .temple {
        position: absolute;
        z-index: 4;
        top: clamp(48px, 6vh, 72px);
        left: 50%;
        width: min(560px, 56vw, calc(40vh * 901 / 730));
        transform: translateX(-50%);
        pointer-events: none;
        line-height: 0;
        aspect-ratio: 901 / 730;
      }

      .temple picture {
        display: block;
        width: 100%;
      }

      .temple img {
        width: 100%;
        height: auto;
        display: block;
        mix-blend-mode: multiply;
        filter:
          drop-shadow(34px 38px 18px rgba(46, 37, 31, 0.19))
          drop-shadow(70px 64px 34px rgba(46, 37, 31, 0.1));
      }

      .destination {
        position: absolute;
        z-index: 6;
        top: 29%;
        width: 64px;
        min-height: 68px;
        display: grid;
        place-content: center;
        gap: 5px;
        border: 1px solid var(--hairline);
        background: transparent;
        color: var(--ink);
        font: 12px/1 Georgia, 'Times New Roman', serif;
        text-decoration: none;
        pointer-events: auto;
      }
      .destination::before {
        content: '';
        width: 26px;
        height: 7px;
        margin: auto;
        border-top: 2px solid currentColor;
        border-radius: 50%;
      }
      .destination:hover {
        background: rgba(46, 37, 31, 0.06);
        color: var(--ink);
      }
      .destination.left {
        left: clamp(24px, 6vw, 108px);
      }
      .destination.right {
        right: clamp(24px, 6vw, 108px);
      }

      .headline {
        position: absolute;
        z-index: 6;
        left: clamp(28px, 6vw, 112px);
        bottom: clamp(38px, 8vh, 92px);
        width: min(320px, 30vw);
        pointer-events: none;
      }

      .eyebrow {
        margin: 0 0 16px;
        font: 12px/1.3 ui-monospace, SFMono-Regular, Menlo, monospace;
        color: var(--muted);
      }

      h1 {
        margin: 0;
        font: 500 clamp(44px, 5.2vw, 78px) / 0.9 Georgia, 'Times New Roman', serif;
        letter-spacing: 0;
      }

      .rule {
        display: inline-block;
        width: 76px;
        margin-left: 15px;
        border-top: 1px solid var(--ink);
        transform: translateY(-0.35em);
      }

      .caption {
        position: absolute;
        z-index: 6;
        right: clamp(28px, 8vw, 152px);
        bottom: clamp(52px, 11vh, 126px);
        width: min(230px, 21vw);
        margin: 0;
        color: var(--muted);
        font: 11px/1.45 ui-monospace, SFMono-Regular, Menlo, monospace;
        pointer-events: none;
      }

      .scan-hint {
        position: absolute;
        z-index: 6;
        left: 50%;
        bottom: 22px;
        width: max-content;
        transform: translateX(-50%);
        text-align: center;
        pointer-events: none;
      }

      .progress {
        width: 140px;
        height: 2px;
        margin: 0 auto 8px;
        background: rgba(46, 37, 31, 0.18);
      }
      .progress::before {
        content: '';
        display: block;
        width: 42%;
        height: 100%;
        background: rgba(46, 37, 31, 0.55);
      }

      .scan-hint p {
        margin: 0;
        font: 10px/1.3 ui-monospace, SFMono-Regular, Menlo, monospace;
        color: var(--muted);
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      .cursor {
        position: absolute;
        z-index: 12;
        width: 12px;
        height: 12px;
        border: 1px solid rgba(46, 37, 31, 0.72);
        border-radius: 50%;
        transform: translate(-50%, -50%);
        opacity: 0;
        pointer-events: none;
      }
      .artboard.is-active .cursor {
        opacity: 1;
      }

      .settings {
        position: absolute;
        z-index: 20;
        top: 62px;
        right: clamp(24px, 5vw, 94px);
        width: 248px;
        padding: 16px;
        border: 1px solid var(--hairline);
        background: var(--panel);
        box-shadow: 16px 18px 32px rgba(46, 37, 31, 0.12);
        backdrop-filter: blur(8px);
      }
      .settings[hidden] {
        display: none;
      }
      .setting {
        display: grid;
        gap: 6px;
        margin-bottom: 13px;
      }
      .setting label {
        display: flex;
        justify-content: space-between;
        color: var(--muted);
        font: 11px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
      }
      .setting input[type='range'] {
        width: 100%;
        accent-color: var(--ink);
      }
      .setting select {
        width: 100%;
        border: 1px solid var(--hairline);
        background: transparent;
        color: var(--ink);
        padding: 6px 8px;
        font: 11px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
      }
      .reset {
        width: 100%;
        border: 1px solid var(--hairline);
        padding: 7px 10px;
        color: var(--ink);
        background: transparent;
        cursor: pointer;
        font: 11px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
      }

      .credit {
        position: absolute;
        z-index: 8;
        left: clamp(24px, 5vw, 48px);
        bottom: 22px;
        font: 9px/1.3 ui-monospace, SFMono-Regular, Menlo, monospace;
        color: var(--muted);
        text-decoration: none;
        opacity: 0.7;
      }
      .credit:hover {
        color: var(--ink);
        opacity: 1;
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      @media (max-width: 720px) {
        .masthead {
          grid-template-columns: 1fr auto;
        }
        .nav {
          display: none;
        }
        .temple {
          top: 58px;
          width: min(400px, 88vw, calc(34vh * 901 / 730));
        }
        .destination {
          top: 22%;
          transform: scale(0.86);
        }
        .destination.left {
          left: 16px;
        }
        .destination.right {
          right: 16px;
        }
        .headline {
          left: 24px;
          bottom: 44px;
          width: min(280px, 74vw);
        }
        h1 {
          font-size: clamp(36px, 12vw, 56px);
        }
        .caption {
          display: none;
        }
        .credit {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    <main class="artboard" id="artboard">
      <canvas id="curtain" aria-label="Interactive character curtain that forms a scannable QR code"></canvas>

      <header class="masthead">
        <a class="brand" href="/">Terrerov</a>
        <nav class="nav" aria-label="Primary">
          <a href="mailto:hola@terrerov.com">Contact</a>
          <a href="https://github.com/terrerovgh/terrerov" target="_blank" rel="noopener">GitHub</a>
        </nav>
        <div class="masthead-actions">
          <a class="mail-link" href="mailto:hola@terrerov.com">hola@terrerov.com</a>
          <button class="configure" id="configure" type="button" aria-expanded="false" aria-controls="settings">
            Configure
          </button>
        </div>
      </header>

      <div class="temple" id="temple">
        <picture>
          <source id="temple-webp" srcset="/assets/temple-roof-cutout-web.webp" type="image/webp" />
          <img
            id="temple-img"
            src="/assets/temple-roof-cutout-web.png"
            width="901"
            height="730"
            fetchpriority="high"
            decoding="async"
            alt="Temple of Heaven roof"
          />
        </picture>
      </div>

      <a class="destination left" href="mailto:hola@terrerov.com"><span>Studio</span></a>
      <a class="destination right" href="mailto:hola@terrerov.com"><span>Hello</span></a>

      <section class="headline" id="home">
        <p class="eyebrow">Louisville, KY / English · Español</p>
        <h1>Web design<br />that elevates<span class="rule"></span></h1>
      </section>

      <p class="caption" id="story">
        Independent studio for local business. The curtain is a live QR to this site — leave it still to scan, move to
        chime.
      </p>

      <div class="scan-hint" aria-hidden="true">
        <div class="progress"></div>
        <p>Scan when still · move to chime</p>
      </div>

      <a
        class="credit"
        href="https://github.com/CodeMaryy/temple-of-heaven-curtain"
        target="_blank"
        rel="noopener">After Temple of Heaven Curtain</a
      >

      <div class="cursor" id="cursor" aria-hidden="true"></div>

      <aside class="settings" id="settings" hidden>
        <div class="setting">
          <label for="roof">Roof study</label>
          <select id="roof"></select>
        </div>
        <div class="setting">
          <label for="mode">Curtain</label>
          <select id="mode">
            <option value="qr" selected>QR · terrerov.com</option>
            <option value="classic">Classic characters</option>
          </select>
        </div>
        <div class="setting">
          <label for="strength">Strength <output id="strengthValue">72</output></label>
          <input id="strength" type="range" min="20" max="110" value="72" />
        </div>
        <div class="setting">
          <label for="reach">Reach <output id="reachValue">34</output></label>
          <input id="reach" type="range" min="18" max="56" value="34" />
        </div>
        <div class="setting">
          <label for="inertia">Inertia <output id="inertiaValue">97</output></label>
          <input id="inertia" type="range" min="86" max="99" value="97" />
        </div>
        <button class="reset" id="reset" type="button">Reset curtain</button>
      </aside>

      <p class="sr-only">
        Interactive single-page site. A curtain of Chinese characters hangs from a Temple of Heaven roof and forms a QR
        code encoding https://www.terrerov.com. Contact: hola@terrerov.com.
      </p>
    </main>

    <script>
      import { initCurtain } from '../scripts/curtain';
      initCurtain();
    </script>
  </body>
</html>
