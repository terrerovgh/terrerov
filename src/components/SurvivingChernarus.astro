---
import { survivingChernarus } from '../data/site';

const sc = survivingChernarus;
---

<section class="panel panel--project" id="chernarus" data-panel="chernarus" data-label="Project">
  <div class="panel-inner sc-panel">
    <div class="sc-layout">
      <figure class="sc-mark" data-reveal>
        <picture>
          <source srcset="/assets/surviving-chernarus-logo.webp" type="image/webp" />
          <img
            src="/assets/surviving-chernarus-logo.png"
            alt={sc.logoAlt}
            width="640"
            height="640"
            loading="lazy"
            decoding="async"
          />
        </picture>
      </figure>

      <div class="sc-copy">
        <p class="kicker" data-reveal>{sc.kicker}</p>
        <h2 class="section-title" data-reveal>{sc.title}</h2>
        <p class="lede" data-reveal set:html={sc.lede} />
        <p class="lede sc-lede-2" data-reveal>{sc.body}</p>

        <ul class="sc-pillars" aria-label="Core systems">
          {
            sc.pillars.map((p) => (
              <li class="sc-pillar" data-reveal>
                <span class="sc-pillar__n">{p.n}</span>
                <div>
                  <h3>{p.title}</h3>
                  <p>{p.body}</p>
                </div>
              </li>
            ))
          }
        </ul>

        <div class="sc-actions" data-reveal>
          {
            sc.repoUrl ? (
              <a class="btn btn-primary" href={sc.repoUrl} target="_blank" rel="noopener noreferrer">
                {sc.repoLabel}
              </a>
            ) : null
          }
          <button class="btn btn-ghost" type="button" data-go="contact">
            {sc.ctaLabel}
          </button>
        </div>
      </div>
    </div>
  </div>
</section>
