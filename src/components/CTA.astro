---
import { site } from '../data/site';
---

<section class="band cta-band" id="start">
  <div class="wrap">
    <p class="kicker">Ready when you are</p>
    <h2 class="section-title">Let’s build a site that works for your business.</h2>
    <p class="lede">
      Tell me what you do, where you are, and what the site should achieve. I’ll reply with next steps
      and a clear scope.
    </p>
    <div class="cta-actions">
      <a class="btn" href="#contact">Start a project →</a>
      <a class="btn btn-ghost" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>
</section>
