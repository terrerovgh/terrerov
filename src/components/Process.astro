---
import { process } from '../data/site';
---

<section class="panel panel--deep" id="process" data-panel="process" data-label="Process">
  <div class="panel-inner">
    <p class="kicker" data-reveal>How we work</p>
    <h2 class="section-title" data-reveal>A clear process from first call to launch.</h2>
    <p class="lede" data-reveal>
      No mystery roadmap. You always know the next step, the timeline, and what I need from you.
    </p>
    <div class="process-row">
      {process.map((step) => (
        <article class="process-step" data-reveal>
          <span class="n">{step.n}</span>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
