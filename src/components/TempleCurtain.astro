---
import { getRoof } from '../data/roofs';
import CurtainScene from './CurtainScene.astro';

interface Props {
  qrPayload?: string;
}

const roof = getRoof('heaven');
const { qrPayload } = Astro.props;
const heroRoof = qrPayload ? { ...roof, qrPayload } : roof;
---

<CurtainScene roof={heroRoof} mode="full" />
