---
import { faqs } from '../data/site';
---

<section class="panel panel--tint" id="faq" data-panel="faq" data-label="FAQ">
  <div class="panel-inner">
    <p class="kicker" data-reveal>Questions</p>
    <h2 class="section-title" data-reveal>Straight answers before we start.</h2>
    <p class="lede" data-reveal>
      No jargon, no pressure. If something is not listed here, email me — I reply within one business day.
    </p>

    <div class="faq-list">
      {faqs.map((item) => (
        <details class="faq-item" data-reveal>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
