---
import { faqs } from '../data/site';
---

<section class="wrap" id="faq">
  <p class="kicker">Questions</p>
  <h2 class="section-title">Straight answers before we start.</h2>
  <p class="lede">
    No jargon, no pressure. If something is not listed here, email me — I reply within one business day.
  </p>

  <div class="faq-list">
    {faqs.map((item) => (
      <details class="faq-item">
        <summary>{item.q}</summary>
        <p>{item.a}</p>
      </details>
    ))}
  </div>
</section>
