---
import { services } from '../data/site';
---

<section class="panel panel--deep panel--wide" id="services" data-panel="services" data-label="Services">
  <div class="panel-inner">
    <p class="kicker" data-reveal>What I offer</p>
    <h2 class="section-title" data-reveal>Services for businesses that need results online.</h2>
    <p class="lede" data-reveal>
      Everything is scoped to your goals: more appointments, clearer brand, better local search,
      fewer phone calls that go nowhere.
    </p>

    <div class="services-grid">
      {services.map((s) => (
        <article class="service-card" data-reveal>
          <span class="n">{s.n}</span>
          <h3>{s.title}</h3>
          <p class="es">{s.titleEs}</p>
          <p>{s.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
