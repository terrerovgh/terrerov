---
// Client-side only canvas background with topographic contour lines + subtle particles
// Matches the original design prototype exactly in behavior and appearance
---

<canvas 
  id="bg-canvas"
  class="fixed inset-0 w-full h-full pointer-events-none z-0"
  aria-hidden="true"
></canvas>

<script>
  (function () {
    const cv = document.getElementById('bg-canvas');
    if (!cv) return;

    const canvas = cv;
    const ctx = canvas.getContext('2d', { alpha: true });
    if (!ctx) return;

    let w = 0, h = 0;
    let dpr = Math.min(window.devicePixelRatio || 1, 2);
    let raf = 0;
    let resizeHandler = null;
    const P = [];
    let t = 0;

    // Theme-aware ink color, kept in sync with the .dark class on <html>
    let ink = getInk();
    function getInk() {
      const v = getComputedStyle(document.documentElement)
        .getPropertyValue('--canvas-ink')
        .trim();
      return v || '22, 21, 19';
    }
    const themeObserver = new MutationObserver(() => {
      ink = getInk();
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced) draw();
    });
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

    function resize() {
      w = window.innerWidth;
      h = window.innerHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function seedParticles(n) {
      P.length = 0;
      for (let i = 0; i < n; i++) {
        P.push({
          x: Math.random() * w,
          y: Math.random() * h,
          r: 0.6 + Math.random() * 1.3,
          vx: (Math.random() - 0.5) * 0.08,
          vy: -0.03 - Math.random() * 0.07,
          a: 0.35 + Math.random() * 0.65
        });
      }
    }

    function draw() {
      const opac = 1.7; // default linesOpacity from prototype
      const density = 96; // default particleDensity
      seedParticles(density);

      ctx.clearRect(0, 0, w, h);

      // Topographic contour lines as dotted point-chains
      const lines = 9;
      for (let i = 0; i < lines; i++) {
        const base = h * (0.06 + (i / (lines - 1)) * 0.88);
        const ph = i * 1.7;
        for (let x = -20; x <= w + 20; x += 9) {
          const y = base
            + Math.sin(x * 0.0022 + t * 0.00012 + ph) * 46
            + Math.sin(x * 0.0061 - t * 0.00008 + ph * 2.3) * 18
            + Math.cos(x * 0.0013 + t * 0.00005 + ph * 0.7) * 30;

          ctx.beginPath();
          ctx.arc(x, y, 1.15, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(${ink},${(0.09 * opac).toFixed(4)})`;
          ctx.fill();
        }
      }

      // Particles
      for (const p of P) {
        p.x += p.vx;
        p.y += p.vy;

        if (p.y < -6) {
          p.y = h + 6;
          p.x = Math.random() * w;
        }
        if (p.x < -6) p.x = w + 6;
        if (p.x > w + 6) p.x = -6;

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${ink},${(0.07 * p.a * opac).toFixed(4)})`;
        ctx.fill();
      }

      t += 16;

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduced) {
        raf = requestAnimationFrame(draw);
      }
    }

    function start() {
      resize();
      resizeHandler = resize;
      window.addEventListener('resize', resizeHandler);

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduced) {
        draw();
      } else {
        // Draw static frame for reduced motion
        draw();
      }
    }

    function cleanup() {
      if (raf) cancelAnimationFrame(raf);
      if (resizeHandler) window.removeEventListener('resize', resizeHandler);
      themeObserver.disconnect();
    }

    start();

    // Cleanup on navigation / HMR
    document.addEventListener('astro:before-swap', cleanup);
    window.addEventListener('beforeunload', cleanup);
  })();
</script>
