---
import { clients, deliverables } from '../data/site';
---

<section class="wrap" id="clients">
  <div class="grid-2">
    <div>
      <p class="kicker">What you get</p>
      <h2 class="section-title">A complete handoff, not half a site.</h2>
      <ul class="checklist">
        {deliverables.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
    <div>
      <p class="kicker">Who it’s for</p>
      <h2 class="section-title">Built for operators, not enterprises.</h2>
      <div class="grid-clients">
        {clients.map((c) => (
          <article class="card">
            <h3>{c.title}</h3>
            <p>{c.body}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
