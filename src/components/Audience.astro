---
import { clients, deliverables } from '../data/site';
---

<section class="panel panel--tint" id="clients" data-panel="clients" data-label="Audience">
  <div class="panel-inner">
    <div class="split-2">
      <div>
        <p class="kicker" data-reveal>What you get</p>
        <h2 class="section-title" data-reveal>A complete handoff, not half a site.</h2>
        <ul class="checklist">
          {deliverables.map((item) => (
            <li data-reveal>{item}</li>
          ))}
        </ul>
      </div>
      <div>
        <p class="kicker" data-reveal>Who it’s for</p>
        <h2 class="section-title" data-reveal>Built for operators, not enterprises.</h2>
        <div class="clients-grid">
          {clients.map((c) => (
            <article class="card" data-reveal>
              <h3>{c.title}</h3>
              <p>{c.body}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
